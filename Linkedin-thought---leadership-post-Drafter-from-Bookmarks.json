        "responses": {
          "values": [
            {
              "content": "=You are an expert content analyst.\n\nYour task is to analyze the article content provided below for a LinkedIn Thought-Leadership Post Drafter.\n\nExtract only information that is supported by the article.\n\nIdentify:\n\n1. Main topic and core message\n2. 3–5 important facts or statistics\n3. 2–3 surprising or counter-intuitive insights\n4. Key lessons or takeaways for professionals\n5. Why this topic matters to a LinkedIn audience\n6. Useful context that can help create an engaging LinkedIn post\n\nDo not invent facts, statistics, quotes, or claims.\n\nDo not write the final LinkedIn post yet.\nReturn a clear, structured analysis that another AI step can use to draft the final LinkedIn post.\n\nARTICLE CONTENT:\n\n{{ $json.articleContent }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
